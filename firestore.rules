rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in ["diegoi.rojas.santander@gmail.com"];
    }

    match /users/{userId} {
      allow read, update, delete: if ownsUserDocument(userId);
      allow create: if ownsUserDocument(userId);
    }

    match /quotes/{quoteId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
